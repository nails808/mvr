{
  "name": "mvr-verify-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create mvr-verify",
    "db:migrate:local": "wrangler d1 execute mvr-verify --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute mvr-verify --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}

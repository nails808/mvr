# Set these in Cloudflare Worker → Settings → Variables and Secrets
# Do not commit real values to a public repo.

APP_API_KEY=<shared-with-frontend>
BOT_SECRET=<random-string-for-telegram-webhook>
ADMIN_IDS=<your-telegram-numeric-id>
BOT_TOKEN=<paste-from-BotFather>

# Web Push (VAPID)
# Generate once — see PUSH_SETUP.md
VAPID_PUBLIC_KEY=<base64url-public-key>
VAPID_PRIVATE_KEY=<full-EC-JWK-JSON-string>
VAPID_SUBJECT=mailto:admin@example.com

# Frontend .env (browser-visible):
# VITE_WORKER_URL=https://telegram-user-manager.<subdomain>.workers.dev
# VITE_APP_API_KEY=<same as APP_API_KEY>
# VITE_VAPID_PUBLIC_KEY=<same as VAPID_PUBLIC_KEY>
